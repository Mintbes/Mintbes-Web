{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "video",
          "value": "(?<slug>[^&]+)"
        }
      ],
      "destination": "/v/:slug",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "(?<slug>[^&]+)"
        }
      ],
      "destination": "/v/:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/v/:id",
      "destination": "/api/og?video=:id"
    },
    {
      "source": "/video/:id",
      "destination": "/api/og?video=:id"
    }
  ]
}
