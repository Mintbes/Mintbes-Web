{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "video",
          "value": "(?<slug>[^&]+)"
        }
      ],
      "destination": "https://www.mintbes.country/v/:slug",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "(?<slug>[^&]+)"
        }
      ],
      "destination": "https://www.mintbes.country/v/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v/videosAI/:path*",
      "destination": "/videosAI/:path*"
    },
    {
      "source": "/v/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/v/:id",
      "destination": "/api/og?video=:id"
    },
    {
      "source": "/video/:id",
      "destination": "/api/og?video=:id"
    }
  ]
}
